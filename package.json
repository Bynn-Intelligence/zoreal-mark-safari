{
  "name": "zoreal-mark-safari",
  "version": "0.1.0",
  "private": true,
  "description": "ZOREAL Mark for Safari: verify that a real human, verified by ZOREAL, vouched for what you are reading, and sign what you post.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bynn-Intelligence/zoreal-mark-safari.git"
  },
  "homepage": "https://zoreal.com",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:local": "tsc --noEmit && vite build --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mock": "node dev/mock/server.mjs",
    "icons": "node scripts/make-icons.mjs && node scripts/make-lucide.mjs",
    "pack": "node scripts/pack.mjs",
    "build:safari": "npm run build && node scripts/safari-dist.mjs",
    "build:safari:local": "npm run build:local && node scripts/safari-dist.mjs"
  },
  "dependencies": {
    "@zoreal/mark-verify": "github:Bynn-Intelligence/zoreal-mark-verify#41655e28e4f67b61cdcd966fdbcb82f6fff59e89",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "lucide-static": "^0.560.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
